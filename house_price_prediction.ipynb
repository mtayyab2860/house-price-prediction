# ## 9. Model Interpretation and Insights

# %%
# Analyze prediction errors
error_analysis = pd.DataFrame({
    'Actual': y_test_original,
    'Predicted_LR': y_pred_lr_original,
    'Predicted_RF': y_pred_rf_original,
    'Predicted_GB': y_pred_gb_original,
    'Error_LR': residuals_lr,
    'Error_RF': residuals_rf,
    'Error_GB': residuals_gb
})

# Calculate percentage error
error_analysis['Pct_Error_LR'] = (error_analysis['Error_LR'] / error_analysis['Actual']) * 100
error_analysis['Pct_Error_RF'] = (error_analysis['Error_RF'] / error_analysis['Actual']) * 100
error_analysis['Pct_Error_GB'] = (error_analysis['Error_GB'] / error_analysis['Actual']) * 100

print("\nError Analysis Summary:")
print("="*60)
print(f"\nLinear Regression:")
print(f"Average Absolute Error: ${abs(error_analysis['Error_LR']).mean():,.0f}")
print(f"Average Percentage Error: {abs(error_analysis['Pct_Error_LR']).mean():.1f}%")

print(f"\nRandom Forest:")
print(f"Average Absolute Error: ${abs(error_analysis['Error_RF']).mean():,.0f}")
print(f"Average Percentage Error: {abs(error_analysis['Pct_Error_RF']).mean():.1f}%")

print(f"\nGradient Boosting:")
print(f"Average Absolute Error: ${abs(error_analysis['Error_GB']).mean():,.0f}")
print(f"Average Percentage Error: {abs(error_analysis['Pct_Error_GB']).mean():.1f}%")

# %%
# Analyze where models perform best/worst
error_analysis['Price_Category'] = pd.qcut(error_analysis['Actual'], q=4, 
                                          labels=['Low', 'Medium-Low', 'Medium-High', 'High'])

category_performance = error_analysis.groupby('Price_Category').agg({
    'Pct_Error_LR': 'mean',
    'Pct_Error_RF': 'mean',
    'Pct_Error_GB': 'mean'
}).abs()

