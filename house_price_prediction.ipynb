    'Random Forest': cv_rmse_rf,
    'Gradient Boosting': cv_rmse_gb
})

print("\nCross-Validation RMSE Scores (log scale):")
print(cv_results)

print("\nMean Cross-Validation RMSE:")
print(f"Linear Regression: {cv_rmse_lr.mean():.4f}")
print(f"Random Forest: {cv_rmse_rf.mean():.4f}")
print(f"Gradient Boosting: {cv_rmse_gb.mean():.4f}")

