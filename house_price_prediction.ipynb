# %% [markdown]
# ## 4. Data Preprocessing

# %%
# Separate features and target
X = data.drop('MedHouseVal', axis=1)
y = data['MedHouseVal']

# Apply log transformation to target to handle skewness
y_log = np.log1p(y)

# Visualize transformation
fig, axes = plt.subplots(1, 2, figsize=(12, 4))

axes[0].hist(y, bins=50, edgecolor='black', alpha=0.7)
axes[0].set_xlabel('Original House Value ($)')
axes[0].set_ylabel('Frequency')
axes[0].set_title('Original Target Distribution')
axes[0].grid(True, alpha=0.3)

axes[1].hist(y_log, bins=50, edgecolor='black', alpha=0.7)
axes[1].set_xlabel('Log-Transformed House Value')
axes[1].set_ylabel('Frequency')
axes[1].set_title('Transformed Target Distribution')
axes[1].grid(True, alpha=0.3)

plt.tight_layout()
plt.show()

# %%
# Split the data
X_train, X_test, y_train, y_test = train_test_split(
    X, y_log, test_size=0.2, random_state=42, stratify=pd.qcut(y, q=5)
)

print(f"Training set size: {X_train.shape}")
print(f"Testing set size: {X_test.shape}")
print(f"\nTraining target mean: {np.expm1(y_train).mean():,.2f}")
print(f"Testing target mean: {np.expm1(y_test).mean():,.2f}")

# %%
# Create preprocessing pipeline
numeric_features = X.columns.tolist()

numeric_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='median')),
    ('scaler', StandardScaler())
])

preprocessor = ColumnTransformer(
    transformers=[
        ('num', numeric_transformer, numeric_features)
    ])

print("Preprocessing pipeline created successfully!")

# %% [markdown]
# ## 5. Feature Engineering and Selection

# %%
# Create new features
def create_features(df):
    df = df.copy()
    
    # Create interaction features
    df['IncomePerRoom'] = df['MedInc'] / (df['AveRooms'] + 1)
    df['BedroomRatio'] = df['AveBedrms'] / (df['AveRooms'] + 1)
    df['PopulationDensity'] = df['Population'] / (df['AveOccup'] + 1)
    
    # Create polynomial features
    df['MedInc_squared'] = df['MedInc'] ** 2
    df['HouseAge_squared'] = df['HouseAge'] ** 2
    
    # Create location clusters based on latitude and longitude
    df['LatLong_Cluster'] = (df['Latitude'] // 2 * 10 + df['Longitude'] // 2).astype(int)
    
    return df

# Apply feature engineering
X_train_fe = create_features(X_train)
X_test_fe = create_features(X_test)

print(f"Original features: {X_train.shape[1]}")
print(f"After feature engineering: {X_train_fe.shape[1]}")

# %%
# Update numeric features list
numeric_features = X_train_fe.columns.tolist()

# Update preprocessor
numeric_transformer = Pipeline(steps=[
    ('imputer', SimpleImputer(strategy='median')),
    ('scaler', StandardScaler())
])

preprocessor = ColumnTransformer(
    transformers=[
        ('num', numeric_transformer, numeric_features)
    ])

# %% [markdown]
# ## 6. Model Implementation

# %%
# Define model pipelines
linear_reg_pipeline = Pipeline(steps=[
    ('preprocessor', preprocessor),
    ('regressor', LinearRegression())
])

random_forest_pipeline = Pipeline(steps=[
    ('preprocessor', preprocessor),
    ('regressor', RandomForestRegressor(random_state=42, n_jobs=-1))
])

# Additional model: Gradient Boosting
gradient_boosting_pipeline = Pipeline(steps=[
    ('preprocessor', preprocessor),
    ('regressor', GradientBoostingRegressor(random_state=42))
])

print("Model pipelines created successfully!")

# %%
# Hyperparameter tuning for Random Forest
param_grid_rf = {
    'regressor__n_estimators': [100, 200],
    'regressor__max_depth': [10, 20, None],
    'regressor__min_samples_split': [2, 5, 10],
    'regressor__min_samples_leaf': [1, 2, 4]
}

# Hyperparameter tuning for Gradient Boosting
param_grid_gb = {
    'regressor__n_estimators': [100, 200],
    'regressor__learning_rate': [0.01, 0.1, 0.2],
    'regressor__max_depth': [3, 4, 5]
}

print("Starting model training with hyperparameter tuning...")

# Train Linear Regression
print("\n1. Training Linear Regression...")
linear_reg_pipeline.fit(X_train_fe, y_train)

# Train Random Forest with GridSearch
print("\n2. Training Random Forest (this may take a few minutes)...")
rf_grid_search = GridSearchCV(
    random_forest_pipeline,
    param_grid_rf,
    cv=3,
    scoring='neg_mean_squared_error',
    n_jobs=-1,
    verbose=0
)
rf_grid_search.fit(X_train_fe, y_train)
best_rf_model = rf_grid_search.best_estimator_

# Train Gradient Boosting with GridSearch
print("\n3. Training Gradient Boosting (this may take a few minutes)...")
gb_grid_search = GridSearchCV(
    gradient_boosting_pipeline,
    param_grid_gb,
    cv=3,
    scoring='neg_mean_squared_error',
    n_jobs=-1,
    verbose=0
)
gb_grid_search.fit(X_train_fe, y_train)
best_gb_model = gb_grid_search.best_estimator_

print("\nModel training completed!")
print(f"Best Random Forest parameters: {rf_grid_search.best_params_}")
print(f"Best Gradient Boosting parameters: {gb_grid_search.best_params_}")

# %% [markdown]
# ## 7. Model Evaluation and Results

# %%
# Make predictions
y_pred_lr = linear_reg_pipeline.predict(X_test_fe)
y_pred_rf = best_rf_model.predict(X_test_fe)
y_pred_gb = best_gb_model.predict(X_test_fe)

# Convert predictions back from log scale
y_test_original = np.expm1(y_test)
y_pred_lr_original = np.expm1(y_pred_lr)
y_pred_rf_original = np.expm1(y_pred_rf)
y_pred_gb_original = np.expm1(y_pred_gb)

# Calculate metrics
def calculate_metrics(y_true, y_pred, model_name):
    mae = mean_absolute_error(y_true, y_pred)
    rmse = np.sqrt(mean_squared_error(y_true, y_pred))
    r2 = r2_score(y_true, y_pred)
    mape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100
    
    return {
        'Model': model_name,
        'MAE': mae,
        'RMSE': rmse,
        'R²': r2,
        'MAPE': mape
    }

# Calculate metrics for all models
metrics_lr = calculate_metrics(y_test_original, y_pred_lr_original, 'Linear Regression')
metrics_rf = calculate_metrics(y_test_original, y_pred_rf_original, 'Random Forest')
metrics_gb = calculate_metrics(y_test_original, y_pred_gb_original, 'Gradient Boosting')

# Create comparison dataframe
results_df = pd.DataFrame([metrics_lr, metrics_rf, metrics_gb])
results_df.set_index('Model', inplace=True)

print("="*70)
print("MODEL PERFORMANCE COMPARISON")
print("="*70)
print(results_df.round(4))

